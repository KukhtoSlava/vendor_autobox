// kotlinx-serialization 1.7.3 — overrides the system external/kotlinx.serialization (1.8.1).
//
// PROBLEM: androidx.datastore_datastore-core-okio has static_libs: ["kotlinx_serialization_json"]
// which pulls in AOSP's 1.8.1 build. In 1.8.1, JsonObject.Companion was removed. TomTom SDK
// 2.1.2 accesses JsonObject.Companion via getstatic bytecode and crashes with NoSuchFieldError.
//
// FIX: prefer:true on kotlinx_serialization_json makes Soong use this prebuilt instead of the
// java_library source in external/kotlinx.serialization, so only ONE version of JsonObject
// (1.7.3, with Companion) ends up in the dex.
//
// NOTE: kotlinx_serialization_core is NOT overridden with prefer:true because that would break
// kotlinx_serialization_core_test which uses associates:["kotlinx_serialization_core"] — the
// associates mechanism requires the source module, not a prebuilt.
// Instead, autobox-kotlinx-serialization-core (1.7.3) is listed as a static_lib here so that
// any transitive consumer of kotlinx_serialization_json also gets core 1.7.3.
java_import {
    name: "kotlinx_serialization_json",
    prefer: true,
    jars: ["thirdparty/kotlinx-serialization-json.jar"],
    sdk_version: "core_current",
    min_sdk_version: "24",
    static_libs: ["autobox-kotlinx-serialization-core"],
    apex_available: [
        "//apex_available:anyapex",
        "//apex_available:platform",
    ],
}

java_import {
    name: "autobox-kotlinx-serialization-json",
    jars: ["thirdparty/kotlinx-serialization-json.jar"],
    sdk_version: "current",
}

java_import {
    name: "autobox-kotlinx-serialization-core",
    jars: ["thirdparty/kotlinx-serialization-core.jar"],
    sdk_version: "core_current",
    min_sdk_version: "24",
    apex_available: [
        "//apex_available:anyapex",
        "//apex_available:platform",
    ],
}

