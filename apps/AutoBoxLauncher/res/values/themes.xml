<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.AutoBoxLauncher" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Explicit AppCompat attrs so AppCompatDelegateImpl.createSubDecor() finds windowActionBar
             regardless of which AppCompat version wins the resource merge -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>
</resources>